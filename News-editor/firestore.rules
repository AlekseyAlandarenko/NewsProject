rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /articles/{id} {

      allow read: if true;

      allow create, update: if request.auth != null
        && isValidArticle(request.resource.data);

      allow delete: if request.auth != null;
    }

    function isValidArticle(data) {
      return data.title is string
        && data.title.size() > 0
        && data.blocks is list
        && allBlocksValid(data.blocks);
    }

    function allBlocksValid(blocks) {
      return blocks.size() > 0
        && blocks.every(b => blockValid(b));
    }

    function blockValid(b) {
      return b.id is string
        && b.type in ['text', 'image', 'quote', 'code', 'file']
        && b.content is map;
    }
  }
}